-- Visual Effect Setup
local ColorEffect = Instance.new("ColorCorrectionEffect")
ColorEffect.Name = "DeltaTimeStopEffect"
ColorEffect.Enabled = false
ColorEffect.Parent = Lighting

-- Time Stop Logic
local function toggleTimeStop()
	isTimeStopped = not isTimeStopped

	if isTimeStopped then
		TimeStopButton.Text = "Time Stop: ON"
		TimeStopButton.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
		ColorEffect.Enabled = true
		
		TweenService:Create(ColorEffect, TweenInfo.new(0.5), {
			Saturation = -1,
			Contrast = 0.5,
			TintColor = Color3.fromRGB(150, 180, 255)
		}):Play()

		for _, player in pairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
				player.Character.HumanoidRootPart.Anchored = true
			end
		end
	else
		TimeStopButton.Text = "Time Stop: OFF"
		TimeStopButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
		
		local tween = TweenService:Create(ColorEffect, TweenInfo.new(0.5), {
			Saturation = 0,
			Contrast = 0,
			TintColor = Color3.fromRGB(255, 255, 255)
		})
		tween:Play()
		tween.Completed:Connect(function()
			if not isTimeStopped then
				ColorEffect.Enabled = false
			end
		end)

		for _, player in pairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
				player.Character.HumanoidRootPart.Anchored = false
			end
		end
	end
end

-- Events
TimeStopButton.MouseButton1Click:Connect(toggleTimeStop)
ToggleButton.MouseButton1Click:Connect(function()
	MenuFrame.Visible = not MenuFrame.Visible
end)
